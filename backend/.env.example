PORT=5000
DATABASE_URL="mongodb+srv://user:pass@cluster.mongodb.net/shiftscheduler"
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"

# Real-Time Email Dispatch Configuration (Gmail / SMTP / SendGrid)
# Option A: Gmail App Password (recommended for instant setup)
GMAIL_USER="your-email@gmail.com"
GMAIL_PASS="your-16-char-app-password"

# Option B: Custom SMTP Server
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
SMTP_SECURE=false

# Option C: SendGrid API Key
SENDGRID_API_KEY=""
SENDER_EMAIL="noreply@shiftscheduler.com"

